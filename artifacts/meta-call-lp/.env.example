# Required by Replit artifact preview. Local defaults: PORT=3000, BASE_PATH=/
PORT=19711
BASE_PATH=/meta-call-lp/

# JotForm embed URL for the confidential assessment.
# Do not invent a production form ID. Paste the real form URL when ready.
# Hidden fields Greg should add on the form: utm_source, utm_medium,
# utm_campaign, utm_term, utm_content, fbclid, gclid, variant
VITE_JOTFORM_URL=

# VSL source. Empty = branded placeholder. Accepts YouTube, Vimeo, or mp4/webm.
VITE_VSL_URL=

# Optional. Leave empty until real IDs exist. Never commit live secrets.
VITE_META_PIXEL_ID=
VITE_GTAG_ID=
